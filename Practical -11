edges = [
    (1, 2, 10),
    (1, 3, 6),
    (2, 3, 5),
    (2, 4, 15),
    (3, 4, 4)
]

parent = {}

def find(x):
    if parent[x] != x:
        parent[x] = find(parent[x])
    return parent[x]

def union(a, b):
    parent[find(a)] = find(b)

# Initialize parent
vertices = set()

for u, v, w in edges:
    vertices.add(u)
    vertices.add(v)

for v in vertices:
    parent[v] = v

# Sort edges by weight
edges.sort(key=lambda x: x[2])

mst = []
cost = 0

for u, v, w in edges:
    if find(u) != find(v):
        union(u, v)
        mst.append((u, v, w))
        cost += w

print("Minimum Spanning Tree:")
for edge in mst:
    print(edge)

print("Minimum Cost:", cost)
